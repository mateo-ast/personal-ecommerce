<% const heroOffer = offerProducts[0]; %>

<section class="hero">
  <div class="hero__content">
    <span class="hero__badge">Oferta especial</span>
    <h1 class="hero__title"><%= heroOffer.name %></h1>
    <p class="hero__description"><%= heroOffer.description %></p>
    <div class="hero__prices">
      <span class="hero__price">$<%= heroOffer.price.toLocaleString('es-AR') %></span>
      <% if (heroOffer.originalPrice) { %>
        <span class="hero__original-price">$<%= heroOffer.originalPrice.toLocaleString('es-AR') %></span>
      <% } %>
    </div>
    <a href="/productos/<%= heroOffer.id %>" class="hero__btn">Ver oferta</a>
  </div>
  <div class="hero__image">
    <img src="<%= heroOffer.image %>" alt="<%= heroOffer.name %>" />
  </div>
</section>

<section class="section">
  <h2 class="section__title">Ofertas del día</h2>
  <div class="product-grid">
    <% offerProducts.forEach(function(product) { %>
      <a href="/productos/<%= product.id %>" class="product-card">
        <div class="product-card__image-wrapper">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="product-card__image" />
          <% if (product.originalPrice) { %>
            <span class="product-card__offer-badge">-<%= Math.round((1 - product.price / product.originalPrice) * 100) %>%</span>
          <% } %>
        </div>
        <div class="product-card__body">
          <span class="product-card__category"><%= product.category %></span>
          <h3 class="product-card__name"><%= product.name %></h3>
          <div class="product-card__prices">
            <span class="product-card__price">$<%= product.price.toLocaleString('es-AR') %></span>
            <% if (product.originalPrice) { %>
              <span class="product-card__original-price">$<%= product.originalPrice.toLocaleString('es-AR') %></span>
            <% } %>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
</section>

<section class="section">
  <h2 class="section__title">Productos destacados</h2>
  <div class="product-grid">
    <% featuredProducts.forEach(function(product) { %>
      <a href="/productos/<%= product.id %>" class="product-card">
        <div class="product-card__image-wrapper">
          <img src="<%= product.image %>" alt="<%= product.name %>" class="product-card__image" />
        </div>
        <div class="product-card__body">
          <span class="product-card__category"><%= product.category %></span>
          <h3 class="product-card__name"><%= product.name %></h3>
          <div class="product-card__prices">
            <span class="product-card__price">$<%= product.price.toLocaleString('es-AR') %></span>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
</section>
