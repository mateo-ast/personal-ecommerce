<nav class="navbar">
  <a href="/" class="navbar__logo">
    <img src="/images/logo.svg" alt="MiTienda - Inicio" class="navbar__logo-img">
  </a>

  <form class="navbar__search" role="search">
    <label for="searchInput" class="visually-hidden">Buscar productos</label>
    <input
      type="search"
      id="searchInput"
      class="navbar__search-input"
      placeholder="Buscar productos..."
      autocomplete="off"
    >
    <button type="submit" class="navbar__search-btn" aria-label="Buscar">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
    </button>
  </form>

  <div class="navbar__actions">
    <a href="/carrito" class="navbar__cart" title="Mi Carrito">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
    </a>

    <div class="navbar__session">
    <button class="navbar__session-btn" id="sessionToggle">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      Mi Cuenta
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <div class="navbar__dropdown" id="sessionDropdown">
      <a href="/auth/login" class="navbar__dropdown-item">Iniciar Sesión</a>
      <a href="/auth/register" class="navbar__dropdown-item">Registrarse</a>
    </div>
  </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('sessionToggle');
  const dropdown = document.getElementById('sessionDropdown');

  toggle?.addEventListener('click', () => {
    dropdown?.classList.toggle('navbar__dropdown--active');
  });

  document.addEventListener('click', (e) => {
    if (!toggle?.contains(e.target) && !dropdown?.contains(e.target)) {
      dropdown?.classList.remove('navbar__dropdown--active');
    }
  });
</script>